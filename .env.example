# Database
# In Coolify use the PostgreSQL service's INTERNAL URL (not localhost):
# postgresql://USER:PASSWORD@SERVICE_NAME:5432/bros_membership
# URL-encode special characters in the password.
DATABASE_URL="postgresql://bros:bros_secret@localhost:5432/bros_membership"

# API
NODE_ENV=development
API_PORT=3002
API_PREFIX=/api
# Public port nginx listens on inside the single-service container.
# Coolify maps the domain to this port ("Ports Exposes" = 80).
PORT=80

# JWT — required in production; the server refuses to boot with a weak/missing secret.
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins. Empty = same-origin only in production
# (the single-service image already serves SPA + API on one origin).
CORS_ORIGINS=http://localhost:5173

# Reverse proxy: number of trusted proxy hops in front of Express.
# Coolify proxy → nginx → Express = 2. Use 1 only if nginx is bypassed.
# TRUST_PROXY=2

# Seed (used by `npm run db:seed`). Change before use.
# In production SEED_ADMIN_PASSWORD is required — seeding refuses to run without it.
# The officer account is optional; leave SEED_OFFICER_PASSWORD empty to skip it.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_EMAIL=officer@gmail.com
# SEED_OFFICER_PASSWORD=officer123

# Container startup (Dockerfile/entrypoint)
# RUN_MIGRATIONS=true
# RUN_SEED=true   # first deploy only, then set back to false

# Frontend (optional) — only needed when the SPA calls the API on another origin
# at build time. For the single-service Docker deploy the SPA uses a relative /api.
# Do NOT set this in Coolify for the single-service setup.
# VITE_API_URL=http://localhost:3002/api
