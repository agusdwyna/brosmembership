# Database
DATABASE_URL="postgresql://bros:bros_secret@localhost:5432/bros_membership"

# API
NODE_ENV=development
API_PORT=3002
API_PREFIX=/api

# JWT — required in production; the server refuses to boot with a weak/missing secret.
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins. Empty = reflect any origin (dev only).
CORS_ORIGINS=http://localhost:5173

# Reverse proxy (nginx/Coolify): trust X-Forwarded-For. 'true' | 'false' | hop count.
# Leave empty when the app is reached directly so rate limiting uses the real IP.
# TRUST_PROXY=1

# Seed (used by `npm run db:seed`). Change before use.
# In production both passwords are required — seeding refuses to run without them.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_EMAIL=officer@gmail.com
SEED_OFFICER_PASSWORD=officer123

# Container startup (Dockerfile/entrypoint)
# RUN_MIGRATIONS=true
# RUN_SEED=false

# Frontend (optional) — only needed when the SPA calls the API on another origin
# at build time. For the single-service Docker deploy the SPA uses a relative /api.
# VITE_API_URL=http://localhost:3002/api
