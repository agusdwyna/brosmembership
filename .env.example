# Database
DATABASE_URL="postgresql://bros:bros_secret@localhost:5432/bros_membership"

# API
NODE_ENV=development
API_PORT=3002
API_PREFIX=/api

# JWT
# Wajib diisi acak & kuat kecuali NODE_ENV=development/test (server menolak start jika kosong/default).
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS — daftar origin dipisah koma. Kosong = izinkan semua (hanya untuk dev).
CORS_ORIGINS=http://localhost:5173

# Reverse proxy (nginx/Coolify): percayai X-Forwarded-For. 'true' | 'false' | jumlah hop (mis. 1).
# Biarkan kosong bila app diakses langsung, agar rate limit memakai IP asli.
# TRUST_PROXY=1

# Seed kredensial (opsional). Ganti sebelum dipakai.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_EMAIL=officer@gmail.com
SEED_OFFICER_PASSWORD=officer123

# Frontend
VITE_API_URL=http://localhost:3002/api
