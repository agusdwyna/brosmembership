generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OFFICER") // ADMIN | OFFICER
  status       String   @default("ACTIVE")  // ACTIVE | INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanHistory   ScanHistory[]
  activityLogs  ActivityLog[]
  visits        Visit[]
  @@map("users")
}

// Configurable roles. `User.role` stores Role.key (plain string), so adding or
// editing roles never touches the users table. `key` is immutable once created.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// ─── Companies ──────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  email     String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members Member[]

  @@map("companies")
}

// ─── Members ────────────────────────────────────────────

model Member {
  id           String   @id @default(cuid())
  memberNumber String   @unique
  // NIK is personal data and is never stored in plaintext: `nikHash` is an
  // HMAC (key in the environment) used for uniqueness and NIK lookup, and
  // `nikLast4` is the only part shown to operators.
  nikHash      String?  @unique
  nikLast4     String?
  qrHash       String?  @unique
  fullName     String
  phone        String?
  email        String?
  photo        String?
  address      String?
  dateOfBirth  DateTime?
  companyId    String?
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  // Soft delete: a deleted member disappears from lists, search and the scanner
  // but keeps its memberships/cards/history. Hard deletion (see the FK rules
  // below) is still possible straight in the database when data must really go.
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company?       @relation(fields: [companyId], references: [id])
  memberships  Membership[]
  scanHistory  ScanHistory[]
  activityLogs ActivityLog[]
  visits       Visit[]

  @@map("members")
}

// ─── Membership Types ───────────────────────────────────

model MembershipType {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  description         String?
  duration            Int      // dalam hari
  status                  String   @default("ACTIVE") // ACTIVE | INACTIVE
  defaultCardTemplateId   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  defaultCardTemplate CardTemplate? @relation(fields: [defaultCardTemplateId], references: [id])
  memberships Membership[]

  @@map("membership_types")
}

// ─── Memberships ────────────────────────────────────────

model Membership {
  id               String   @id @default(cuid())
  memberId         String
  membershipTypeId String
  startDate        DateTime
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED | EXPIRED | CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Cascading from Member lets a hard delete in the database remove the
  // member's own memberships (and, in turn, their cards) without a manual
  // cleanup. The membership type is a master row shared by many members, so
  // deleting a type that is still in use stays blocked (RESTRICT).
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipType MembershipType  @relation(fields: [membershipTypeId], references: [id])
  cards          MembershipCard[]
  scanHistory    ScanHistory[]
  visits         Visit[]

  @@map("memberships")
}

// ─── Card Templates ─────────────────────────────────────

model CardTemplate {
  id           String   @id @default(cuid())
  name         String
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sides                    CardTemplateSide[]
  defaultForMembershipType MembershipType[]
  cards                    MembershipCard[]

  @@map("card_templates")
}

model CardTemplateSide {
  id             String @id @default(cuid())
  cardTemplateId String
  side           String // FRONT | BACK
  designUrl      String?

  elements CardTemplateElement[]

  cardTemplate CardTemplate @relation(fields: [cardTemplateId], references: [id], onDelete: Cascade)

  @@unique([cardTemplateId, side])
  @@map("card_template_sides")
}

model CardTemplateElement {
  id                 String @id @default(cuid())
  cardTemplateSideId String
  type               String // MEMBER_NAME | MEMBER_NUMBER | MEMBERSHIP_NAME | EXPIRY_DATE | QR_CODE
  x                  Float
  y                  Float
  width              Float
  height             Float
  fontSize           Float?
  fontWeight         String? // normal | bold
  alignment          String? // left | center | right

  side CardTemplateSide @relation(fields: [cardTemplateSideId], references: [id], onDelete: Cascade)

  @@map("card_template_elements")
}

// ─── Membership Cards ───────────────────────────────────

model MembershipCard {
  id              String    @id @default(cuid())
  membershipId    String
  cardNumber      String    @unique
  cardTemplateId  String
  templateVersion Int       @default(1)
  issuedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  cardTemplate CardTemplate @relation(fields: [cardTemplateId], references: [id])

  @@map("membership_cards")
}

// ─── Scan History ───────────────────────────────────────

// ─── Settings ──────────────────────────────────────────

// Application-level settings stored as a key-value map. Values are strings;
// numeric/bool settings are parsed by the settings service on read.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── Activity Log ─────────────────────────────────────

model ActivityLog {
  id           String   @id @default(cuid())
  // Optional: member-scoped actions (assign/renew/...) set it; user- and
  // settings-level actions (create user, update settings, ...) do not.
  memberId     String?
  action       String   // ASSIGN | CHANGE_TYPE | RENEW | SUSPEND | CANCEL | CREATE_USER | ...
  description  String
  oldValue     String?
  newValue     String?
  performedBy  String
  createdAt    DateTime @default(now())

  // Cascades on a hard delete: removing a member removes its activity history
  // too, which is the point of a hard delete (the app itself soft-deletes).
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  officer  User    @relation(fields: [performedBy], references: [id])

  @@map("activity_logs")
}

model ScanHistory {
  id           String   @id @default(cuid())
  memberId     String?
  membershipId String?
  result       String   // VALID | EXPIRED | SUSPENDED | CANCELLED | NOT_FOUND
  reason       String?
  scannerMethod String  // MANUAL | PHYSICAL_READER | CAMERA
  officerId    String
  createdAt    DateTime @default(now())

  // Cascades with the member: a hard delete removes the member's scan rows too.
  member     Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  officer    User           @relation(fields: [officerId], references: [id])

  @@map("scan_history")
}

// A recorded visit: the front office confirmed a validated member went on to
// register at the (separate) SIMRS. Kept apart from ScanHistory so visit data
// stays clean; `scanId` links back to the scan that triggered it and being
// unique stops a single scan from recording a visit twice.
model Visit {
  id           String   @id @default(cuid())
  memberId     String
  membershipId String?
  officerId    String
  scanId       String?  @unique
  createdAt    DateTime @default(now())

  // A hard delete in the database is meant to remove the member completely,
  // history included, so visits (and their scans) cascade away with them.
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id])
  officer    User        @relation(fields: [officerId], references: [id])

  @@map("visits")
}
